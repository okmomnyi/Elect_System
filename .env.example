# ==========================================
# University Voting System — Environment Variables
# ==========================================
# Copy this file to .env and fill in the values

# ==========================================
# Application Settings
# ==========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3002
ALLOWED_EMAIL_DOMAIN=@university.edu

# ==========================================
# PostgreSQL Database
# ==========================================
POSTGRES_USER=voting_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=voting_db
DATABASE_URL=postgresql://voting_user:change_me_strong_password@postgres:5432/voting_db
DATABASE_POOL_SIZE=20

# ==========================================
# Redis Cache
# ==========================================
REDIS_PASSWORD=change_me_strong_password
REDIS_URL=redis://:change_me_strong_password@redis:6379

# ==========================================
# RabbitMQ Message Queue
# ==========================================
RABBITMQ_USER=voting_user
RABBITMQ_PASSWORD=change_me_strong_password
RABBITMQ_URL=amqp://voting_user:change_me_strong_password@rabbitmq:5672
VOTE_QUEUE=votes.primary
VOTE_RETRY_QUEUE=votes.retry
VOTE_DEAD_QUEUE=votes.dead

# ==========================================
# JWT Authentication (RS256)
# ==========================================
# Generate a key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste the file contents below, replacing each newline with \n

JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<your RS256 private key>\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<your RS256 public key>\n-----END PUBLIC KEY-----"
JWT_EXPIRY=86400

# ==========================================
# Brevo Transactional Email
# ==========================================
# Create a free account at https://app.brevo.com
# API key: Settings → SMTP & API → API Keys → Generate a new API key
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@yourdomain.edu
BREVO_SENDER_NAME=University Voting System

# ==========================================
# Bootstrap Admin User
# ==========================================
# Created automatically on first server start if this email is not in the DB
BOOTSTRAP_ADMIN_EMAIL=admin@university.edu
BOOTSTRAP_ADMIN_NAME=System Administrator
